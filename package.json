{
  "name": "makima-tui",
  "version": "0.1.0",
  "description": "Makima TUI for deepseek-harness with JellyFish colors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentforce314/dsh-makimaTUI.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build:ink": "npm run build --prefix packages/makima-tui-ink",
    "dev": "npm run build:ink && tsx --watch src/entry.tsx",
    "start": "tsx src/entry.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build:ink",
    "test": "vitest run",
    "pretest:watch": "npm run build:ink",
    "test:watch": "vitest",
    "build:plugin": "node scripts/build-plugin.mjs",
    "pack:plugin": "npm run build && node scripts/pack-plugin.mjs",
    "build": "npm run build:ink && npm run build:plugin",
    "install:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "prepare": "npm run build",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "e2e": "npm run build && python3 scripts/e2e/run_core.py",
    "e2e:install": "npm run build && python3 scripts/e2e/run_install.py"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-base": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-plan-mode": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@makima-tui/ink": "file:./packages/makima-tui-ink",
    "@nanostores/react": "^1.1.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "diff": "^9.0.0",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.11.1",
    "ink": "^6.8.0",
    "ink-text-input": "^6.0.0",
    "nanostores": "^1.2.0",
    "react": "^19.2.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "undici": "^6.25.0",
    "unicode-animations": "^1.0.3",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "main": "dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js"
  },
  "files": [
    "bin",
    "dist/plugin.js",
    "dist/openai-codex-auth.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "bin": {
    "makima-tui": "./bin/makima-tui.js",
    "makima-tui-auth": "./bin/makima-tui-auth.js"
  }
}
